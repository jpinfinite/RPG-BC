extends Resource
class_name HeroData

enum Elemento {
	ANTI_MAGIA,
	AGUA,
	VENTO,
	FOGO,
	LUZ,
	TREVAS
}

@export var id: String = ""
@export var nome: String = ""
@export var titulo: String = ""
@export var elemento: Elemento = Elemento.ANTI_MAGIA
@export var dps_base: float = 10.0
@export var multiplicador_nivel: float = 1.15
@export var icone_ou_sprite: Texture2D
@export_multiline var descricao: String = ""
